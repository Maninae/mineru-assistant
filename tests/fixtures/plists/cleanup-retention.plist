<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mineru.cleanup-retention</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/example/.mineru/scripts/cleanup-retention.sh</string>
    </array>

    <!-- monthly on the 2nd at 04:07 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>7</integer>
    </dict>

    <key>TimeOut</key>
    <integer>1800</integer>

    <key>WorkingDirectory</key>
    <string>/Users/example/.mineru</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/example/.local/bin</string>
        <key>HOME</key>
        <string>/Users/example</string>
        <key>MINERU_HOME</key>
        <string>/Users/example/.mineru</string>
        <key>MINERU_KEYCHAIN_ACCOUNT</key>
        <string>mineru</string>
        <key>MINERU_INJECT_QUEUE_DIR</key>
        <string>/Users/example/.mineru/cache/inject-queue</string>
    </dict>
</dict>
</plist>
