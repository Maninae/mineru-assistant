<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mineru.keepsake-autodeploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/example/.mineru/scripts/keepsake-autodeploy.py</string>
    </array>

    <!-- daily at 03:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>TimeOut</key>
    <integer>600</integer>

    <key>WorkingDirectory</key>
    <string>/Users/example/.mineru</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/example/.local/bin</string>
        <key>HOME</key>
        <string>/Users/example</string>
        <key>MINERU_HOME</key>
        <string>/Users/example/.mineru</string>
        <key>MINERU_KEYCHAIN_ACCOUNT</key>
        <string>mineru</string>
        <key>MINERU_INJECT_QUEUE_DIR</key>
        <string>/Users/example/.mineru/cache/inject-queue</string>
    </dict>
</dict>
</plist>
