<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LAUNCHD_PREFIX}}.daily-transactions</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{MINERU_HOME}}/scripts/trigger-daily-transactions-claude-code.sh</string>
    </array>

    <!-- Thursday at 10:00 PM (launchd: 0=Sun, 4=Thu) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>4</integer>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>TimeOut</key>
    <integer>1800</integer>

    <key>WorkingDirectory</key>
    <string>{{MINERU_HOME}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{USER_HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{USER_HOME}}</string>
        <key>MINERU_HOME</key>
        <string>{{MINERU_HOME}}</string>
        <key>MINERU_KEYCHAIN_ACCOUNT</key>
        <string>{{KEYCHAIN_ACCOUNT}}</string>
        <key>MINERU_INJECT_QUEUE_DIR</key>
        <string>{{MINERU_INJECT_QUEUE_DIR}}</string>
    </dict>
</dict>
</plist>
