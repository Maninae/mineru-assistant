<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{LAUNCHD_PREFIX}}.memory-dedup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{MINERU_HOME}}/scripts/trigger-memory-dedup-claude-code.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{USER_HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>{{USER_HOME}}</string>
		<key>MINERU_HOME</key>
		<string>{{MINERU_HOME}}</string>
		<key>MINERU_KEYCHAIN_ACCOUNT</key>
		<string>{{KEYCHAIN_ACCOUNT}}</string>
		<key>MINERU_INJECT_QUEUE_DIR</key>
		<string>{{MINERU_INJECT_QUEUE_DIR}}</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>{{MINERU_HOME}}</string>
	<key>StandardOutPath</key>
	<string>{{MINERU_HOME}}/logs/memory-dedup/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>{{MINERU_HOME}}/logs/memory-dedup/launchd-stderr.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>22</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
