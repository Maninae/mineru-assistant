<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LAUNCHD_PREFIX}}.morning-brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{MINERU_HOME}}/scripts/trigger-morning-brief-claude-code.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>TimeOut</key>
    <integer>3600</integer>

    <key>WorkingDirectory</key>
    <string>{{MINERU_HOME}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{USER_HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{USER_HOME}}</string>
        <key>MINERU_HOME</key>
        <string>{{MINERU_HOME}}</string>
        <key>MINERU_KEYCHAIN_ACCOUNT</key>
        <string>{{KEYCHAIN_ACCOUNT}}</string>
        <key>MINERU_INJECT_QUEUE_DIR</key>
        <string>{{MINERU_INJECT_QUEUE_DIR}}</string>
{{#if WEATHER_LOCATION}}
        <key>MINERU_WEATHER_LOCATION</key>
        <string>{{WEATHER_LOCATION}}</string>
        <key>MINERU_WEATHER_LAT</key>
        <string>{{WEATHER_LAT}}</string>
        <key>MINERU_WEATHER_LON</key>
        <string>{{WEATHER_LON}}</string>
        <key>MINERU_WEATHER_LABEL</key>
        <string>{{WEATHER_LABEL}}</string>
{{/if}}
    </dict>
</dict>
</plist>
