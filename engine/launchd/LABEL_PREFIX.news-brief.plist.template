<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LAUNCHD_PREFIX}}.news-brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{MINERU_HOME}}/scripts/trigger-news-brief-claude-code.sh</string>
    </array>

    <!-- Mon/Wed/Fri at 11:00 (Weekday: 1=Mon, 3=Wed, 5=Fri): one full topic rotation per week. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>TimeOut</key>
    <integer>3600</integer>

    <key>WorkingDirectory</key>
    <string>{{MINERU_HOME}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{USER_HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{USER_HOME}}</string>
        <key>MINERU_HOME</key>
        <string>{{MINERU_HOME}}</string>
        <key>MINERU_KEYCHAIN_ACCOUNT</key>
        <string>{{KEYCHAIN_ACCOUNT}}</string>
        <key>MINERU_INJECT_QUEUE_DIR</key>
        <string>{{MINERU_INJECT_QUEUE_DIR}}</string>
    </dict>
</dict>
</plist>
