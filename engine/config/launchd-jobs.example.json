    {"label_suffix": "prompts-alignment", "display_name": "Prompts Alignment", "freshness": {"kind": "newest_in_dir", "dir": "briefs_prompts_alignment"}},
    {"label_suffix": "inbox-triage", "display_name": "Inbox Triage", "freshness": {"kind": "newest_in_dir", "dir": "briefs_inbox"}},
